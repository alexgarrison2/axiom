# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
# python
**/__pycache__/
*.py[cod]
*$py.class
pipeline/*.csv
!pipeline/nhl_season_*_gamestats.csv
!pipeline/nhl_season_*_shots.csv
!pipeline/nhl_season_*_shifts.csv

# Large generated files - regenerated by backfill_pbp.py
pipeline/nhl_season_*_pbp.csv

# Large scraped historical data
data/historical_pbp/*.csv

# local databases / credential stores (never commit)
*.db
*.sqlite
*.sqlite3

# --- repo hygiene: personal files, one-off output and logs never belong in git ---
# personal / third-party documents
*.pdf
*.xlsx
*.xls
TeamLogos_hockeystats
# screenshots, audit and social-image output
/output/
/.playwright-cli/
/DailyImages/
/SocialImages/
# ad-hoc analysis notebooks and scraped pages (keep in a separate repo)
/analysis/
# logs, debug dumps and backups
*.log
*.bak
*.bak_*
pipeline/debug_output*.txt
# stale duplicates of pipeline outputs (canonical copies live in public/data and data/)
public/data/shots.csv
public/data/prediction_history.json
pipeline/data/gamestats.csv
pipeline/data/predictions_detailed.csv
pipeline/data/last_updated.json
data/nhl_season_*_gamestats.csv
.claude/worktrees/

# bottom-up model data lake (DESIGN §2.3, D4): raw JSON + parquet live outside git
/data/lake/
